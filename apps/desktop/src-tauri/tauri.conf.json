{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nexora",
  "version": "0.1.1",
  "identifier": "com.nexora.desktop",

  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "Nexora",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },

  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0REYwMUVGNkM5ODlERkQKUldUOW5aaHM3d0hmNURyZXNNQkNLcHRIeFovYXFTT1hndTVQTitLc0hmaXBlaTNwZVpyNGt6MzIK",
      "endpoints": [
        "https://github.com/A9H8J9/nexora/releases/latest/download/latest.json"
      ]
    }
  }
}